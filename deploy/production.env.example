# Copy this file to deploy/production.env and fill in real values there.
# production.env is gitignored — it must never be committed. This .example
# file is the only one that belongs in git.
#
#   cp deploy/production.env.example deploy/production.env
#
# ── Domains ──────────────────────────────────────────────────────────────
# The site (e.g. skilrize.com) and the API subdomain (e.g. api.skilrize.com).
# Both must have DNS A records pointing at this server's public IP before you
# start the stack, or Caddy cannot obtain HTTPS certificates for them.
DOMAIN=your-domain.com
API_DOMAIN=api.your-domain.com

# ── Django core secrets ─────────────────────────────────────────────────
# Generate each of these three independently — never reuse one value for
# more than one of them, and never reuse the dev/CI placeholders from
# docker-compose.yml or api/conftest.py. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
FILE_SIGNING_KEY=
FIELD_ENCRYPTION_KEY=

DEBUG=False
ENVIRONMENT=production
ALLOWED_HOSTS=api.your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
FRONTEND_URL=https://your-domain.com

# ── Database ─────────────────────────────────────────────────────────────
# POSTGRES_HOST/PORT are not set here — they're hardcoded to the internal
# Docker service name in docker-compose.prod.yml, since they're never
# anything else in this topology.
POSTGRES_DB=skilrize
POSTGRES_USER=skilrize
POSTGRES_PASSWORD=

# ── Outbound email ───────────────────────────────────────────────────────
# Pick a transactional email provider (Postmark, SES, Mailgun, etc.) and use
# its SMTP credentials here. Do not attempt to self-host outbound mail —
# Oracle (and most cloud providers) block outbound port 25 by default
# specifically to stop spam relays, so a self-hosted mail server will not be
# able to send anywhere.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=SkilRize <no-reply@your-domain.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ── Backups (see deploy/backup.sh) ──────────────────────────────────────
# A Backblaze B2 bucket (or any S3-compatible target rclone supports) that
# nightly database + upload backups get shipped to, off this VM.
B2_BUCKET=
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=

# ── Payments — Swich (D55) ───────────────────────────────────────────────
# Buyers pay on Swich's hosted checkout: card, Easypaisa, JazzCash, 1Bill.
# Until SWICH_ENABLED is True with the merchant account's keys, checkout
# says payments are opening shortly and places no order. SWICH_ENV is
# sandbox or production (Swich's own environment). In the Swich merchant
# portal, register the callback URL
#   https://<API_DOMAIN>/api/v1/payments/swich/callback/
# (Admin console → Settings shows the exact one).
SWICH_ENABLED=False
SWICH_ENV=production
SWICH_CLIENT_ID=
SWICH_CLIENT_SECRET=
SWICH_SECRET_KEY=
# Payouts to freelancers and refunds to buyers through Swich (D56). Turn on
# once Swich has whitelisted this server's IP address, the payout balance
# is funded, and the bank codes in api/payments/institutions.py match the
# list Swich gave you. Off: they are sent by hand from the admin console.
SWICH_PAYOUTS_ENABLED=False
# The commission percentage taken out of every milestone on release.
PLATFORM_COMMISSION_PERCENT=10.0

# ── Connected accounts (Settings → Connected accounts, D36/D51) ────────
# Each provider shows "Coming soon" until its flag is True and both keys
# are set. deploy/README.md step 10 walks through registering each app;
# the redirect URL for each is https://<DOMAIN>/integrations/callback/<name>
# with <name> one of zoom, google_meet, github, figma, notion.
ZOOM_ENABLED=False
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GOOGLE_MEET_ENABLED=False
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ENABLED=False
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FIGMA_ENABLED=False
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
NOTION_ENABLED=False
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

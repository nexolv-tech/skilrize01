# ---------------------------------------------------------------------------
# SkilRize environment. Copy to .env and fill in. Never commit .env.
#
# Every security control below defaults to its SECURE value when DEBUG is off.
# The variables exist so a control can be relaxed *deliberately* — for a local
# walkthrough, or when an outage makes the alternative worse — not so that a
# deployment has to remember to switch them on.
# ---------------------------------------------------------------------------

# Core -----------------------------------------------------------------------
SECRET_KEY=dev-only-change-me-in-every-real-environment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api
ENVIRONMENT=local

# Database -------------------------------------------------------------------
POSTGRES_DB=skilrize
POSTGRES_USER=skilrize
POSTGRES_PASSWORD=skilrize
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (cache, sessions, rate limits, lockout counters, Celery broker) ------
REDIS_URL=redis://localhost:6379/0

# Web client -----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
FRONTEND_URL=http://localhost:3000

# Cookies --------------------------------------------------------------------
# COOKIE_SECURE is forced True whenever DEBUG is off, and cannot be relaxed by
# this variable in a deployed environment. It is the setting most likely to
# reach production by being copied out of somebody's local .env, and the cost
# of getting it wrong is every session token readable on the wire.
COOKIE_SECURE=False
COOKIE_DOMAIN=

# Passwords ------------------------------------------------------------------
# The floor for a NEW password. Raising it is safe at any time; existing
# passwords are unaffected until their next change. Composition rules (all four
# character classes, no runs or keyboard walks) are not configurable.
PASSWORD_MIN_LENGTH=12

# Brute-force protection -----------------------------------------------------
# Two independent budgets. The per-account one bounds credential stuffing at a
# single account from anywhere; the per-address one catches a spray across many
# accounts, which no single account's counter would ever see.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=1800
LOGIN_IP_MAX_FAILURES=10
LOGIN_IP_WINDOW_SECONDS=600
LOGIN_IP_BLOCK_SECONDS=3600

# New devices ----------------------------------------------------------------
# An account with no authenticator must prove control of its inbox before an
# unrecognised device gets a session. Turn off only if outbound mail is down
# and the alternative is locking everyone out.
REQUIRE_NEW_DEVICE_VERIFICATION=True
# Hold on money-adjacent actions from a device seen for the first time. Set to 0
# for a local walkthrough; half an hour is the shipping default.
DEVICE_COOLOFF_SECONDS=1800

# File storage. Local private storage in dev; S3-compatible later. -----------
STORAGE_BACKEND=local
STORAGE_ROOT=.storage
FILE_SIGNING_KEY=dev-only-file-signing-key-change-me

# Antivirus ------------------------------------------------------------------
# Point CLAMAV_HOST at a clamd instance and every upload is streamed to it
# before it can be downloaded. With REQUIRE_FILE_SCANNER on and no scanner
# reachable, uploads are quarantined rather than passed — the pipeline fails
# closed on purpose.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
REQUIRE_FILE_SCANNER=False

# Interim admin --------------------------------------------------------------
# Moving the console off /admin/ is not a security control on its own, but it
# takes the account out of every commodity scanner's first request.
ADMIN_URL=admin/

# Email ------------------------------------------------------------------
# The file-based backend writes each message as a .log file into
# EMAIL_FILE_PATH (relative to api/), so verification links and reset tokens
# can be opened and clicked without an SMTP account. Console prints the same
# content to stdout instead, which is fine until a second terminal is watching
# a different process and the message scrolls past unseen. Point at real SMTP
# (EMAIL_HOST / _PORT / _HOST_USER / _HOST_PASSWORD / _USE_TLS) for anything
# beyond a laptop.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=.mail
DEFAULT_FROM_EMAIL=SkilRize <no-reply@skilrize.com>

# Next.js --------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: a hero video in web/public/. Without it the hero renders as a
# layered colour field, which is the default rather than a placeholder.
# NEXT_PUBLIC_HERO_VIDEO=/hero.mp4
# NEXT_PUBLIC_HERO_POSTER=/hero.jpg

# Payments through Swich's hosted checkout (D55). Off until a merchant
# account's keys are set; checkout then says payments are opening shortly.
# Sandbox keys work locally; SWICH_ENV picks Swich's sandbox or production.
SWICH_ENABLED=False
SWICH_ENV=sandbox
SWICH_CLIENT_ID=
SWICH_CLIENT_SECRET=
SWICH_SECRET_KEY=
PLATFORM_COMMISSION_PERCENT=10.0

# ---------------------------------------------------------------------------
# SkilRize environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Core -----------------------------------------------------------------------
SECRET_KEY=dev-only-change-me-in-every-real-environment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api
ENVIRONMENT=local

# Database -------------------------------------------------------------------
POSTGRES_DB=skilrize
POSTGRES_USER=skilrize
POSTGRES_PASSWORD=skilrize
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (cache, sessions, rate limits, Celery broker) ------------------------
REDIS_URL=redis://localhost:6379/0

# Web client -----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Cookies. Set COOKIE_SECURE=True anywhere that is not local http. -----------
COOKIE_SECURE=False
COOKIE_DOMAIN=

# File storage. Local private storage in dev; S3-compatible later. -----------
STORAGE_BACKEND=local
STORAGE_ROOT=.storage
FILE_SIGNING_KEY=dev-only-file-signing-key-change-me

# Email. console backend prints to stdout in dev. ----------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SkilRize <no-reply@skilrize.com>

# Next.js --------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

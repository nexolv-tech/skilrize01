# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
.next/
out/
*.tsbuildinfo

# Environment & secrets
.env
.env.*
!.env.example
# Real production secrets — only production.env.example belongs in git
deploy/production.env
# Local backup output on the server before/after upload to B2
deploy/backups/

# Local storage (uploads land here in dev)
api/.storage/

# whitenoise's collectstatic output — generated, and only ever needed at
# runtime inside a built image, never checked in
api/staticfiles/

# Filebased email backend — verification links and OTP codes in dev, real
# credentials for whoever reads them, never something to commit
api/.mail/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local agent/dev tooling (machine-specific paths)
.claude/
